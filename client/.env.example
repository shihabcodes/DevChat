# Client environment variables. Copy to .env.local for local development and
# set the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys. Both are safe to expose to browsers;
# the database's row level security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: Google sign-in. Leave empty to hide the Google button.
# Requires the Google provider to be enabled in Supabase with this client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
